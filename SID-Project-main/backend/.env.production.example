# =====================================================================
# Боевая конфигурация SID. Скопируйте в .env на сервере и заполните.
# Сервер откажется стартовать, если секреты остались из шаблона.
# =====================================================================

NODE_ENV=production
PORT=3000
API_VERSION=v1

# --- База данных -----------------------------------------------------
# Драйвер memory в production недопустим: данные живут до перезапуска.
DB_DRIVER=postgres
DB_AUTO_MIGRATE=false
DB_HOST=
DB_PORT=5432
DB_NAME=sid_production
DB_USER=
DB_PASSWORD=
DB_SSL=true

# --- Ключи -----------------------------------------------------------
# Сгенерировать все три: npm run generate-secrets
# ENCRYPTION_KEY нельзя менять после первой записи данных — иначе
# зашифрованные телефоны и тексты заказов станут нечитаемыми.
# Держите его резервную копию отдельно от резервной копии базы.
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Администратор ---------------------------------------------------
# Учётная запись заводится командой: npm run create-admin -- --email you@domain.ru
# Пароль в этом файле хранить не нужно.
ADMIN_EMAIL=
ADMIN_NAME=

# --- Redis -----------------------------------------------------------
# Без Redis лимиты считаются в памяти процесса: при нескольких экземплярах
# приложения ограничения перестают быть общими. Для production включайте.
REDIS_DISABLED=false
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Ограничения -----------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5
LOGIN_LOCK_MAX=5
LOGIN_LOCK_WINDOW_MS=900000

# --- Безопасность ----------------------------------------------------
# Стоимость хеширования пароля. 12 — разумный минимум для боевой среды.
BCRYPT_ROUNDS=12
# Домены через запятую, с которых разрешены запросы. Звёздочку не ставить.
CORS_ORIGIN=https://your-domain.ru

# --- Журналы ---------------------------------------------------------
LOG_LEVEL=warn
LOG_FILE=logs/app.log

# Basic-авторизация панели документации на порту 3001.
# Без значения длиной от 12 символов панель не запускается.
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=
