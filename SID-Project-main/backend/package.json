{
  "name": "sid-api",
  "version": "1.0.0",
  "description": "SID Project API with PostgreSQL, Redis, and Security Features",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js",
    "create-admin": "node src/database/create-admin.js",
    "generate-secrets": "node src/utils/generate-secrets.js",
    "init-db": "npm run migrate && npm run seed"
  },
  "keywords": ["api", "express", "postgresql", "security"],
  "author": "SID Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "pg-mem": "^3.0.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "redis": "^4.6.11",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "compression": "^1.7.4",
    "express-mongo-sanitize": "^2.2.0",
    "hpp": "^0.2.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
