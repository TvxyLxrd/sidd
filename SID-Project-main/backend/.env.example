# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration (Main)
DB_DRIVER=postgres
DB_AUTO_MIGRATE=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sid_main
DB_USER=sid_user
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# Database Configuration (Test)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=sid_test
TEST_DB_USER=sid_test_user
TEST_DB_PASSWORD=your_test_password_here
TEST_DB_SSL=false

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production_minimum_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_this_in_production_minimum_32_characters
JWT_REFRESH_EXPIRES_IN=30d

# Redis Configuration
REDIS_DISABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
UPLOAD_DIR=uploads

# Data encryption at rest (AES-256-GCM). Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Account lockout after repeated failed logins
LOGIN_LOCK_MAX=5
LOGIN_LOCK_WINDOW_MS=900000

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000,http://localhost:19006,http://localhost:19000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Admin account
# Used by "npm run create-admin" and, with the memory driver, on startup.
# Leave ADMIN_PASSWORD empty to have a strong one generated and printed once.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Admin Panel
ADMIN_PANEL_PORT=3001

# Basic-авторизация панели документации на порту 3001.
# Без значения длиной от 12 символов панель не запускается.
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=
