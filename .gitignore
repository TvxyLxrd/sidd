# Зависимости
node_modules/

# Секреты. .env содержит ключи шифрования и доступ к базе —
# в репозиторий он не попадает ни при каких обстоятельствах.
.env
.env.local
.env.production
*.pem
*.key

# Журналы
logs/
*.log

# Загруженные файлы
uploads/

# Системное
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Сборки
build/
dist/
coverage/

# Важно: файлы схемы базы (*.sql) намеренно НЕ исключены —
# без schema.sql приложение не поднимется на новом сервере.
